      "source": [
        "import ipaddress\n",
        "\n",
        "ip = input(\"Enter IP address: \")\n",
        "\n",
        "try:\n",
        "    address = ipaddress.ip_address(ip)\n",
        "\n",
        "    print(\"Valid IP Address\")\n",
        "    print(\"Version:\", address.version)\n",
        "\n",
        "except ValueError:\n",
        "    print(\"Invalid IP Address\")"
      ]
    }
  ]
